{
  "name": "iina-quick-folders-plugin",
  "private": true,
  "description": "Development commands for the Quick Folders IINA plugin",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "node --test tests/*.test.js",
    "test:integration": "node --test tests/integration/*.test.js",
    "test:coverage": "node --experimental-test-coverage --test tests/*.test.js tests/integration/*.test.js",
    "test:ui": "playwright test",
    "test:ui:debug": "playwright test --debug",
    "check": "node scripts/check.mjs",
    "package": "bash scripts/package-plugin.sh",
    "verify": "npm run check && npm test && npm run test:ui && npm run package",
    "dev:link": "bash scripts/iina-plugin.sh link",
    "dev:unlink": "bash scripts/iina-plugin.sh unlink",
    "release:prepare": "node scripts/prepare-release.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0"
  }
}
